{
  "name": "Session Reset — wave-complete (30min) ✅",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "id": "sr000001-0000-4000-8000-000000000001",
      "name": "Schedule (every 30 min)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  (SELECT COUNT(*) FROM tickets WHERE workspace_id = 'ws-alpha' AND status IN ('open', 'running')) AS active_count,\n  (SELECT MAX(updated_at) FROM tickets WHERE workspace_id = 'ws-alpha' AND status IN ('done', 'review', 'failed', 'cancelled')) AS last_completed,\n  (SELECT MAX(created_at) FROM logs WHERE workspace_id = 'ws-alpha' AND component = 'system' AND message ILIKE '%session reset%') AS last_reset",
        "options": {}
      },
      "id": "sr000002-0000-4000-8000-000000000002",
      "name": "Check OO reset",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [220, 100],
      "credentials": {
        "postgres": {
          "id": "YOUR_POSTGRES_CREDENTIAL_ID",
          "name": "agentstack-db"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-sr-oo-active",
              "leftValue": "={{ Number($json.active_count) }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            },
            {
              "id": "cond-sr-oo-wave",
              "leftValue": "={{ $json.last_completed !== null && ($json.last_reset === null || new Date($json.last_completed) > new Date($json.last_reset)) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "sr000003-0000-4000-8000-000000000003",
      "name": "OO needs reset?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 100]
    },
    {
