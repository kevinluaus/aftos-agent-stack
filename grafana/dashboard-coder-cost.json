{
  "__inputs": [
    {
      "name": "DS_AGENTSTACK",
      "label": "agentstack",
      "description": "agentstack PostgreSQL datasource",
      "type": "datasource",
      "pluginId": "grafana-postgresql-datasource",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0"},
    {"type": "datasource", "id": "grafana-postgresql-datasource", "name": "PostgreSQL", "version": "1.0.0"}
  ],
  "title": "Coder Cost",
  "uid": "coder-cost-7-17",
  "tags": ["stage7", "coder", "cost"],
  "timezone": "browser",
  "refresh": "5m",
  "time": {"from": "now-7d", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Cost by tier — last 7 days (hourly)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 0},
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "${DS_AGENTSTACK}"},
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"displayMode": "list", "placement": "bottom"}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4
        }
      },
      "targets": [
        {
          "datasource": {"type": "grafana-postgresql-datasource", "uid": "${DS_AGENTSTACK}"},
          "rawSql": "SELECT\n  $__timeGroup(ts, '1h') AS time,\n  router_decision AS metric,\n  SUM(cost_usd) AS value\nFROM coder_calls\nWHERE $__timeFilter(ts)\nGROUP BY 1, 2\nORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Decision split by tier — last 24 h",
      "type": "barchart",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "${DS_AGENTSTACK}"},
      "options": {
        "orientation": "vertical",
        "xTickLabelRotation": 0,
        "legend": {"displayMode": "list", "placement": "bottom"}
      },
      "targets": [
        {
          "datasource": {"type": "grafana-postgresql-datasource", "uid": "${DS_AGENTSTACK}"},
          "rawSql": "SELECT\n  router_decision AS \"Tier\",\n  COUNT(*) AS \"Decisions\"\nFROM coder_calls\nWHERE ts > now() - interval '24 hours'\nGROUP BY 1\nORDER BY 2 DESC",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Opus % last 24 h  (alert threshold: 20%)",
      "type": "gauge",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 8},
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "${DS_AGENTSTACK}"},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 10},
              {"color": "red", "value": 20}
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": {"type": "grafana-postgresql-datasource", "uid": "${DS_AGENTSTACK}"},
          "rawSql": "SELECT\n  ROUND(\n    COUNT(*) FILTER (WHERE router_decision = 'opus-coder') * 100.0\n    / NULLIF(COUNT(*), 0),\n  1) AS \"Opus %\"\nFROM coder_calls\nWHERE ts > now() - interval '24 hours'",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Total cost last 24 h",
      "type": "stat",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 8},
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "${DS_AGENTSTACK}"},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 5}
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": {"type": "grafana-postgresql-datasource", "uid": "${DS_AGENTSTACK}"},
          "rawSql": "SELECT COALESCE(SUM(cost_usd), 0) AS \"Cost USD\"\nFROM coder_calls\nWHERE ts > now() - interval '24 hours'",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Build success / failure timeline — last 7 days (hourly)",
      "description": "Red bars = failures. Alert 7 fires on infra-class failures (Timeout/APIError). Normal escalation failures are expected.",
      "type": "barchart",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "${DS_AGENTSTACK}"},
      "options": {
        "orientation": "vertical",
        "stacking": "normal",
        "legend": {"displayMode": "list", "placement": "bottom"}
      },
      "fieldConfig": {
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "failures"},
            "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]
          },
          {
            "matcher": {"id": "byName", "options": "successes"},
            "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]
          }
        ]
      },
      "targets": [
        {
          "datasource": {"type": "grafana-postgresql-datasource", "uid": "${DS_AGENTSTACK}"},
          "rawSql": "SELECT\n  $__timeGroup(ts, '1h') AS time,\n  SUM(CASE WHEN success THEN 1 ELSE 0 END) AS successes,\n  SUM(CASE WHEN NOT success THEN 1 ELSE 0 END) AS failures\nFROM coder_calls\nWHERE $__timeFilter(ts)\nGROUP BY 1\nORDER BY 1",
          "format": "table",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 38,
  "version": 2
}
