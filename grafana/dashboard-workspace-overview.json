    {
      "id": 18,
      "title": "All Tickets",
      "type": "row",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 29},
      "panels": []
    },

    {
      "id": 19,
      "title": "Ticket detail",
      "description": "Filter by Workspace and Status dropdowns. Defaults to open / running / escalation_pending / review / done. Dep IDs = upstream dependency ticket numbers. Escalated = coder routed to Sonnet or Opus at least once.",
      "type": "table",
      "gridPos": {"h": 14, "w": 24, "x": 0, "y": 30},
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "${DS_AGENTSTACK}"},
      "options": {
        "sortBy": [{"displayName": "ID", "desc": true}],
        "footer": {"show": false},
        "frameIndex": 0
      },
      "fieldConfig": {
        "defaults": {"custom": {"inspect": true}},
        "overrides": [
          {"matcher": {"id": "byName", "options": "ID"},        "properties": [{"id": "custom.width", "value": 55}]},
          {"matcher": {"id": "byName", "options": "Workspace"}, "properties": [{"id": "custom.width", "value": 110}]},
          {"matcher": {"id": "byName", "options": "Title"},     "properties": [{"id": "custom.width", "value": 270}]},
          {
            "matcher": {"id": "byName", "options": "Status"},
            "properties": [
              {"id": "custom.displayMode", "value": "color-background"},
              {"id": "custom.width", "value": 120},
              {"id": "mappings", "value": [{"type": "value", "options": {
                "open":               {"color": "blue",        "index": 0, "text": "open"},
                "running":            {"color": "yellow",      "index": 1, "text": "running"},
                "blocked":            {"color": "orange",      "index": 2, "text": "blocked"},
                "escalation_pending": {"color": "dark-orange", "index": 3, "text": "esc. pending"},
                "review":             {"color": "purple",      "index": 4, "text": "review"},
                "done":               {"color": "green",       "index": 5, "text": "done"},
                "failed":             {"color": "red",         "index": 6, "text": "failed"},
                "cancelled":          {"color": "text",        "index": 7, "text": "cancelled"}
              }}]}
            ]
          },
          {"matcher": {"id": "byName", "options": "Priority"}, "properties": [{"id": "custom.width", "value": 72}]},
          {
            "matcher": {"id": "byName", "options": "Attempts"},
            "properties": [
              {"id": "custom.displayMode", "value": "color-background"},
              {"id": "custom.width", "value": 80},
              {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 2}, {"color": "red", "value": 3}]}},
              {"id": "color", "value": {"mode": "thresholds"}}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Escalated"},
            "properties": [
              {"id": "custom.displayMode", "value": "color-background"},
              {"id": "custom.width", "value": 85},
              {"id": "mappings", "value": [{"type": "value", "options": {
                "YES": {"color": "orange", "index": 0, "text": "YES"},
                "—":   {"color": "green",  "index": 1, "text": "—"}
              }}]}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Cost $"},
            "properties": [
              {"id": "custom.width", "value": 85},
              {"id": "unit",     "value": "currencyUSD"},
              {"id": "decimals", "value": 4}
            ]
          },
          {"matcher": {"id": "byName", "options": "Dep IDs"},     "properties": [{"id": "custom.width", "value": 85}]},
          {"matcher": {"id": "byName", "options": "Last Error"},   "properties": [{"id": "custom.width", "value": 250}, {"id": "custom.wrap", "value": true}]},
          {
            "matcher": {"id": "byName", "options": "PR"},
            "properties": [
              {"id": "links", "value": [{"title": "Open PR", "url": "${__value.raw}", "targetBlank": true}]},
              {"id": "custom.width", "value": 260}
            ]
          },
          {"matcher": {"id": "byName", "options": "Created"},       "properties": [{"id": "custom.width", "value": 105}]},
          {"matcher": {"id": "byName", "options": "Elapsed (min)"}, "properties": [{"id": "custom.width", "value": 105}, {"id": "decimals", "value": 1}]}
        ]
      },
      "targets": [
        {
          "datasource": {"type": "grafana-postgresql-datasource", "uid": "${DS_AGENTSTACK}"},
          "rawSql": "SELECT\n  t.id                                                                        AS \"ID\",\n  t.workspace_id                                                              AS \"Workspace\",\n  LEFT(t.title, 70)                                                           AS \"Title\",\n  t.status                                                                    AS \"Status\",\n  t.priority                                                                  AS \"Priority\",\n  t.attempts                                                                  AS \"Attempts\",\n  CASE WHEN COALESCE(cc.escalated, false) THEN 'YES' ELSE '—' END            AS \"Escalated\",\n  ROUND(COALESCE(cc.total_cost, 0)::numeric, 4)                              AS \"Cost $\",\n  COALESCE(ARRAY_TO_STRING(t.dependencies, ', '), '—')                        AS \"Dep IDs\",\n  LEFT(COALESCE(t.last_error, ''), 130)                                       AS \"Last Error\",\n  t.pr_url                                                                    AS \"PR\",\n  to_char(t.created_at AT TIME ZONE 'UTC', 'MM-DD HH24:MI')                  AS \"Created\",\n  CASE\n    WHEN t.completed_at IS NOT NULL\n      THEN ROUND(EXTRACT(EPOCH FROM (t.completed_at - t.created_at)) / 60.0, 1)\n    WHEN t.started_at IS NOT NULL\n      THEN ROUND(EXTRACT(EPOCH FROM (now() - t.started_at)) / 60.0, 1)\n    ELSE NULL\n  END                                                                         AS \"Elapsed (min)\"\nFROM tickets t\nLEFT JOIN (\n  SELECT ticket_id,\n    SUM(cost_usd)                                                             AS total_cost,\n    BOOL_OR(router_decision IN ('sonnet-coder','opus-coder'))                 AS escalated\n  FROM coder_calls\n  WHERE ticket_id IS NOT NULL\n  GROUP BY ticket_id\n) cc ON cc.ticket_id = t.id\nWHERE t.workspace_id IN ($workspace)\n  AND t.status IN ($status)\nORDER BY t.id DESC\nLIMIT 500",
          "format": "table",
          "refId": "A"
        }
      ]
    }

  ],
  "schemaVersion": 38,
  "version": 3
}
